*~
bin/
*.o
*.dsk
*.d64
*.d81
*.g64
*.ppm
*.png
!/icons/
!/icons/**/*.png
*.gif

# Machine ROM dumps are never committed; keep the ROMs/README.
roms/*
!roms/README

# autotools — generated by ./configure or make, not committed
/Makefile
/Makefile.in
/config.status
/config.log
/config.h
/aclocal.m4
/autom4te.cache/
/configure
/src/.deps/
/src/.dirstamp
/src/vice/.deps/
/src/vice/.dirstamp
/1986

# dist tarballs produced by `make dist`
/1986-*.tar.gz
/1986-0.1.0/
/dist/

# flatpak-builder artifacts and bundles
/.flatpak-builder/
/flatpak-repo/
/fp-build/
/build-dir/
/flatpak-build.log
/1986*.flatpak

# runtime screenshots / capture
1986_*.ppm
1986_*.png
!/1986_logo.png
!/1986.png
!/screenshots/*.png
1986_*.gif

# local scratch / working dirs — never commit
/debug/
/notes/
*.note.md

# Reference material (C128 internals book, memory/ROM maps) stays local. Only
# the project-authored guides below are published.
/docs/*
!/docs/STATUS.md
!/docs/DRIVES.md
!/docs/Z80-CPM.md
!/docs/ML-MONITOR.md
!/docs/SNAPSHOTS.md

# build-aux generated by autoreconf
/build-aux/config.guess
/build-aux/config.sub
/build-aux/compile
/build-aux/depcomp
/build-aux/install-sh
/build-aux/missing

# tests build output
/tests/test-*
