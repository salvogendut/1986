# 1986 configuration
# This file is written by the options overlay (F9 -> save).

scale = 2
fullscreen = 0
smoothing = 0

# CRT / video
crt = 0
crt_scanlines = 35
crt_brightness = 100
crt_contrast = 100
crt_red = 100
crt_green = 100
crt_blue = 100

# Machine
model = 0
fast = 0
# Last selected VIC-II (40) or VDC (80) display mode
display_columns = 80

# Advanced: future hardware drive backend (currently pending; virtual remains active)
real_disk_drive = 0
# Optional second fast virtual drive (IEC units must differ)
second_drive = 0
drive_unit = 8
drive2_unit = 9
disk =
disk2 =

# Native C128 generic .crt or raw external function ROM (.bin/.rom)
cart =
# Optional U36 internal function ROM (.bin/.rom, raw 8/16/32 KiB)
u36 =

# F6 GIF capture
gif_width = 320
gif_fps = 25
gif_ffmpeg = 0

# Directory holding the machine ROM images (kernal.rom, basic.rom, chargen.rom)
rom_dir =
