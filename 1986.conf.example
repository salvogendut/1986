# 1986 configuration
# This file is written by the options overlay (F9 -> save).

scale = 2
fullscreen = 0
smoothing = 0

# CRT / video
crt = 0
crt_scanlines = 35
crt_brightness = 100
crt_contrast = 100
crt_red = 100
crt_green = 100
crt_blue = 100

# Machine
model = 0
fast = 0
# Optional dot-clock Z80 modification: 0 = effective 2 MHz, 1 = 4 MHz
double_z80_frequency = 0
# Last selected VIC-II (40) or VDC (80) display mode
display_columns = 80

# Host gamepad/mouse target and per-port device (0=joystick, 1=1351 mouse)
main_input_port = 2
joy_port_1_mode = 0
joy_port_2_mode = 0
joystick_hidapi = 0

# Temporary development gate for the C128's C64 personality. Default off;
# requires optional basic64 and kernal64 ROM images. The overlay control is
# shown only with Tinker enabled and is not intended as a release feature.
c64_test_mode = 0

# Advanced: ROM-backed 1571 drive if dos1571cr.bin is present (restart to apply)
real_disk_drive = 0
# Original, quiet motor/step audio for the real 1571 (live toggle, default off)
drive_audio_monitor = 0
# Independent translucent motor/head waveform panel, default off
drive_visual_monitor = 0
# Optional second fast virtual drive (IEC units must differ)
second_drive = 0
drive_unit = 8
drive2_unit = 9
# Hardware models selected in Media when Real Disk Drive is On.
# 1571CR supports normal GCR sector reads/writes on D64/D71; 1581 hardware is future.
drive_type = 1571
drive2_type = 1571
disk =
disk2 =

# Native C128 generic .crt or raw external function ROM (.bin/.rom)
cart =
# Optional U36 internal function ROM (.bin/.rom, raw 8/16/32 KiB)
u36 =

# F6 GIF capture
gif_width = 320
gif_fps = 25
gif_ffmpeg = 0

# Directory holding the machine ROM images (kernal.rom, basic.rom, chargen.rom)
rom_dir =

# Last directories visited in the Overlay pickers. These are independent of
# inserted media, so ejecting an image does not reset its picker location.
last_disk_dir =
last_disk2_dir =
last_tape_dir =
last_cart_dir =
last_u36_dir =
